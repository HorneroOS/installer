# Maintainer: HorneroOS contributors <https://github.com/HorneroOS/installer>
# Calamares upstream build with package chooser and initramfs modules enabled.
pkgname=calamares
pkgver=3.4.3
pkgrel=1
pkgdesc='Distribution-independent Linux system installer (HorneroOS module set)'
arch=('x86_64')
url='https://calamares.codeberg.page/'
license=('GPL-3.0-or-later')
depends=('kcoreaddons' 'kpmcore' 'libpwquality' 'qt6-declarative' 'qt6-svg' 'yaml-cpp')
makedepends=('extra-cmake-modules' 'libglvnd' 'ninja' 'qt6-tools' 'qt6-translations')
source=("calamares-$pkgver.tar.gz::https://codeberg.org/Calamares/calamares/archive/v$pkgver.tar.gz")
sha256sums=('78784e6018097e4fe74cbd8f1530929626dcecfe303e14383bc8c074feb34eec')

build() {
  local skip_modules=(
    dracut
    dracutlukscfg
    dummycpp
    dummyprocess
    dummypython
    dummypythonqt
    interactiveterminal
    services-openrc
  )

  cmake -S "$srcdir/calamares" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DWITH_QT6=ON \
    -DINSTALL_CONFIG=ON \
    -DSKIP_MODULES="${skip_modules[*]}" \
    -DBUILD_TESTING=OFF \
    -DKDE_INSTALL_BINDIR=/usr/bin \
    -DKDE_INSTALL_SBINDIR=/usr/sbin \
    -DKDE_INSTALL_LIBDIR=/usr/lib \
    -DKDE_INSTALL_LIBEXECDIR=/usr/libexec \
    -DKDE_INSTALL_INCLUDEDIR=/usr/include \
    -DKDE_INSTALL_LOCALSTATEDIR=/var \
    -DKDE_INSTALL_SHAREDSTATEDIR=/usr/share \
    -DKDE_INSTALL_DATAROOTDIR=/usr/share \
    -DKDE_INSTALL_DATADIR=/usr/share \
    -DKDE_INSTALL_LOCALEDIR=/usr/share/locale \
    -DKDE_INSTALL_MANDIR=/usr/share/man \
    -DKDE_INSTALL_INFODIR=/usr/share/info \
    -DKDE_INSTALL_SYSCONFDIR=/etc \
    -Wno-dev
  cmake --build build --parallel "${VJOBS:-2}"
}

package() {
  DESTDIR="$pkgdir" cmake --install build

  # Calamares normally skips later jobs after a critical package failure.
  # Mark only Hornero's target repo cleanup job as emergency-capable so the
  # temporary repository config is removed on both success and failure.
  local shellprocess_descriptor="$pkgdir/usr/lib/calamares/modules/shellprocess/module.desc"
  [[ -f "$shellprocess_descriptor" ]]
  if ! grep -qx 'emergency: true' "$shellprocess_descriptor"; then
    printf '\nemergency: true\n' >> "$shellprocess_descriptor"
  fi

  install -d "$pkgdir/etc/calamares"
  install -Dm644 "$startdir/../../image/calamares/settings.conf" "$pkgdir/etc/calamares/settings.conf"
  cp -a "$startdir/../../image/calamares/modules" "$pkgdir/etc/calamares/"
  cp -a "$startdir/../../image/calamares/branding" "$pkgdir/etc/calamares/"
  rm -f "$pkgdir/usr/share/applications/calamares.desktop"
  install -Dm644 "$startdir/../../image/calamares/hornero-installer.desktop" \
    "$pkgdir/usr/share/applications/hornero-installer.desktop"
  install -Dm644 "$startdir/../../image/calamares/branding/hornero/hornero-installer.svg" \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/hornero-installer.svg"
}
