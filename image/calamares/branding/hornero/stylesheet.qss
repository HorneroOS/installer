/* HorneroOS Calamares stylesheet on Hornero Signal (RFC 0001 +
 * amendment 3, Signal Visual Language "Signal Bezel").
 *
 * Signal Night roles: ground #0C1016, sunken #10151C, base #141B24,
 * panel #1B2430, raised #24303D, lifted #2C3947, ink #E6EBF1,
 * inkMuted #A9B7C6, rule #2D3B4B, ruleStrong #8393A6, signal #F2AC52,
 * onSignal #1E1304, signalWell #3D2B12, onSignalWell #FFE0B0,
 * focus #8BCEF0, cueWell #163345, onCueWell #D6EFFC, alert #FF8494.
 * Type: IBM Plex Sans / IBM Plex Mono (ttf-ibm-plex on the live medium).
 * Geometry: radius 3, 1 px rule hairlines, 1 px ruleStrong control
 * boundaries, 2 px focus. No gradients, no glass.
 */

* {
    font-family: "IBM Plex Sans";
}

#mainApp,
QMainWindow,
QWidget#mainApp {
    background-color: #141B24;
    color: #E6EBF1;
}

/* Progress sidebar: the step list is an instrument column. */
#sidebarApp {
    background-color: #0C1016;
    color: #E6EBF1;
    border-right: 1px solid #2D3B4B;
}

#logoApp {
    background-color: #0C1016;
}

QLabel {
    color: #E6EBF1;
}

/* Separate windows (the "Continue with Setup?" confirmation, error and
 * cancel dialogs, menus) do not inherit #mainApp: give them the panel
 * role so their light text never lands on Qt's default light palette. */
QDialog,
QMessageBox,
QMenu {
    background-color: #1B2430;
    color: #E6EBF1;
}

QDialog QLabel,
QMessageBox QLabel {
    background-color: transparent;
    color: #E6EBF1;
}

QMenu::item:selected {
    background-color: #3D2B12;
    color: #FFE0B0;
}

QMenu::separator {
    height: 1px;
    background-color: #2D3B4B;
}

/* Welcome page text, requirements container, and error/warning blocks:
 * replace Qt's stock pink error block and grey checker container with
 * Signal Night roles (alert #FF8494 / signalWell #3D2B12). */
#mainText,
#belowWelcomeText {
    background-color: transparent;
    color: #E6EBF1;
}

#CheckerContainer,
#requirementsWidget,
#checkerWidget {
    background-color: #10151C;
    color: #E6EBF1;
    border: 1px solid #2D3B4B;
    border-radius: 3px;
    padding: 6px;
}

#errorLabel,
QLabel[severity="error"],
.error {
    background-color: #1B2430;
    color: #E6EBF1;
    border: 1px solid #FF8494;
    border-left: 3px solid #FF8494;
    border-radius: 3px;
    padding: 8px 12px;
}

#warningLabel,
QLabel[severity="warning"],
.warning {
    background-color: #3D2B12;
    color: #FFE0B0;
    border: 1px solid #F2AC52;
    border-left: 3px solid #F2AC52;
    border-radius: 3px;
    padding: 8px 12px;
}

QLabel:disabled {
    color: #8999AB;
}

QPushButton {
    background-color: transparent;
    color: #E6EBF1;
    border: 1px solid #8393A6;
    border-radius: 3px;
    padding: 6px 16px;
    min-height: 20px;
}

QPushButton:hover {
    background-color: #24303D;
}

QPushButton:pressed {
    background-color: #2C3947;
}

QPushButton:focus {
    border: 2px solid #8BCEF0;
}

QPushButton:disabled {
    color: #8999AB;
    border-color: #2D3B4B;
}

/* The one primary action (Next / Install) carries the signal. */
QPushButton:default {
    background-color: #F2AC52;
    color: #1E1304;
    border: 1px solid #F2AC52;
    font-weight: 600;
}

QPushButton:default:focus {
    border: 2px solid #8BCEF0;
}

QLineEdit,
QComboBox,
QSpinBox,
QPlainTextEdit,
QTextEdit,
QTextBrowser {
    background-color: #10151C;
    color: #E6EBF1;
    border: 1px solid #8393A6;
    border-radius: 3px;
    padding: 4px 8px;
    selection-background-color: #163345;
    selection-color: #D6EFFC;
}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QPlainTextEdit:focus,
QTextEdit:focus {
    border: 2px solid #8BCEF0;
}

QComboBox QAbstractItemView,
QListView,
QTreeView {
    background-color: #1B2430;
    color: #E6EBF1;
    border: 1px solid #2D3B4B;
    selection-background-color: #3D2B12;
    selection-color: #FFE0B0;
    outline: 0;
}

QListView::item:hover,
QTreeView::item:hover {
    background-color: #24303D;
}

QListView::item:selected,
QTreeView::item:selected {
    background-color: #3D2B12;
    color: #FFE0B0;
    border-left: 2px solid #F2AC52;
}

QCheckBox,
QRadioButton {
    color: #E6EBF1;
    spacing: 8px;
}

QProgressBar {
    background-color: #10151C;
    border: 1px solid #2D3B4B;
    border-radius: 3px;
    color: #E6EBF1;
    text-align: center;
    font-family: "IBM Plex Mono";
}

QProgressBar::chunk {
    background-color: #F2AC52;
}

/* ---- Navigation: Back / Next / Cancel, welcome links, About, Debug ---- */

#view-button-next {
    min-width: 96px;
}

#view-button-cancel {
    border-color: #2D3B4B;
    color: #A9B7C6;
}

#view-button-cancel:hover {
    border-color: #8393A6;
    color: #E6EBF1;
}

#aboutButton,
#debugButton,
#donateButton,
#supportButton,
#releaseNotesButton,
#knownIssuesButton {
    background-color: transparent;
    color: #A9B7C6;
    border: 1px solid #2D3B4B;
}

#aboutButton:hover,
#debugButton:hover,
#donateButton:hover,
#supportButton:hover,
#releaseNotesButton:hover,
#knownIssuesButton:hover {
    background-color: #24303D;
    color: #E6EBF1;
}

QToolButton {
    background-color: transparent;
    color: #E6EBF1;
    border: 1px solid #8393A6;
    border-radius: 3px;
    padding: 4px 8px;
}

QToolButton:hover {
    background-color: #24303D;
}

QToolButton:pressed,
QToolButton:checked {
    background-color: #3D2B12;
    color: #FFE0B0;
    border-color: #F2AC52;
}

QToolButton:focus {
    border: 2px solid #8BCEF0;
}

/* ---- Pages: scroll areas, frames, group boxes (partition, users,
 * license, summary) ---- */

#viewManager,
#viewManagerStack,
#scrollAreaWidgetContents,
QScrollArea,
QStackedWidget {
    background-color: #141B24;
    color: #E6EBF1;
    border: none;
}

QAbstractScrollArea {
    background-color: #10151C;
    color: #E6EBF1;
}

QFrame[frameShape="4"],
QFrame[frameShape="5"] {
    color: #2D3B4B;
}

QGroupBox {
    background-color: transparent;
    color: #A9B7C6;
    border: 1px solid #2D3B4B;
    border-radius: 3px;
    margin-top: 14px;
    padding: 8px;
    font-family: "IBM Plex Mono";
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    padding: 0 4px;
    color: #A9B7C6;
}

/* Partition page: device and boot info, the partition bar surround. */
#bootInfoIcon,
#deviceInfoIcon {
    background-color: transparent;
}

#bootInfoLable,
#defineInfoLabel {
    color: #A9B7C6;
    font-family: "IBM Plex Mono";
}

#partitionBarView,
#partitionLabelView {
    background-color: #10151C;
    border: 1px solid #2D3B4B;
    border-radius: 3px;
}

/* License module items. */
#licenseItem,
#licenseItemFullText {
    background-color: #1B2430;
    color: #E6EBF1;
    border: 1px solid #2D3B4B;
    border-radius: 3px;
}

/* ---- Lists and tables: partition table, requirements, summary ---- */

QHeaderView::section {
    background-color: #1B2430;
    color: #A9B7C6;
    border: none;
    border-bottom: 1px solid #8393A6;
    border-right: 1px solid #2D3B4B;
    padding: 4px 8px;
    font-family: "IBM Plex Mono";
}

QTableView,
QTableWidget,
QTreeView,
QListView {
    alternate-background-color: #141B24;
    gridline-color: #2D3B4B;
}

QTableCornerButton::section {
    background-color: #1B2430;
    border: none;
    border-bottom: 1px solid #8393A6;
}

QTableView::item:selected,
QTableWidget::item:selected {
    background-color: #3D2B12;
    color: #FFE0B0;
}

QTreeView::branch:selected {
    background-color: #3D2B12;
}

QTabWidget::pane {
    background-color: #1B2430;
    border: 1px solid #2D3B4B;
}

QTabBar::tab {
    background-color: transparent;
    color: #A9B7C6;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 6px 14px;
    font-family: "IBM Plex Mono";
}

QTabBar::tab:hover {
    color: #E6EBF1;
    background-color: #24303D;
}

QTabBar::tab:selected {
    color: #E6EBF1;
    border-bottom: 2px solid #F2AC52;
}

QSplitter::handle {
    background-color: #2D3B4B;
}

/* ---- Inputs and choice controls ---- */

QCheckBox::indicator,
QRadioButton::indicator {
    width: 14px;
    height: 14px;
    background-color: #10151C;
    border: 1px solid #8393A6;
}

QCheckBox::indicator {
    border-radius: 3px;
}

QRadioButton::indicator {
    border-radius: 8px;
}

QCheckBox::indicator:checked {
    background-color: #F2AC52;
    border-color: #F2AC52;
}

QRadioButton::indicator:checked {
    background-color: #F2AC52;
    border: 4px solid #10151C;
}

QCheckBox::indicator:focus,
QRadioButton::indicator:focus {
    border: 2px solid #8BCEF0;
}

QCheckBox::indicator:disabled,
QRadioButton::indicator:disabled {
    border-color: #2D3B4B;
    background-color: #1B2430;
}

QSlider::groove:horizontal {
    background-color: #10151C;
    border: 1px solid #2D3B4B;
    height: 4px;
}

QSlider::sub-page:horizontal {
    background-color: #F2AC52;
}

QSlider::handle:horizontal {
    background-color: #E6EBF1;
    border: 1px solid #8393A6;
    width: 10px;
    margin: -6px 0;
    border-radius: 3px;
}

QComboBox:on {
    border: 1px solid #F2AC52;
}

QComboBox QAbstractItemView {
    min-width: 120px;
}

/* ---- Progress (install phase) ---- */

#exec-progress {
    min-height: 18px;
}

#exec-message {
    color: #A9B7C6;
    font-family: "IBM Plex Mono";
}

/* ---- Scrollbars ---- */

QScrollBar:vertical {
    background: #10151C;
    width: 10px;
    margin: 0;
}

QScrollBar:horizontal {
    background: #10151C;
    height: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #8393A6;
    border-radius: 3px;
    min-height: 24px;
}

QScrollBar::handle:horizontal {
    background: #8393A6;
    border-radius: 3px;
    min-width: 24px;
}

QScrollBar::handle:hover {
    background: #A9B7C6;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    height: 0;
    width: 0;
    border: none;
    background: none;
}

QScrollBar::add-page,
QScrollBar::sub-page {
    background: #10151C;
}

/* ---- Tooltips and status ---- */

QToolTip {
    background-color: #2C3947;
    color: #E6EBF1;
    border: 1px solid #8393A6;
    padding: 4px 8px;
}

QStatusBar {
    background-color: #0C1016;
    color: #A9B7C6;
}
