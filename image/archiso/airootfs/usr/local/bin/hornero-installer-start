#!/usr/bin/env bash
set -euo pipefail

offline_flag=/tmp/hornero-installer-offline-accepted
offline_repo=/usr/share/hornero-installer/offline-repo
rm -f "$offline_flag"

offer_offline() {
  # Offline is offered only when the on-media repository verifies
  # complete, and only before Calamares (hence before partitioning).
  /usr/bin/python3 /usr/lib/hornero-installer/offline-repo.py \
    --verify-only --repo-dir "$offline_repo" >/dev/null 2>&1 || return 1
  /usr/bin/zenity --question --title='HorneroOS installer' \
    --text='No internet connection was detected. This medium carries a complete offline package repository, so installation can continue without a network. Only the default kernel is available offline. Continue offline?' \
    --ok-label='Continue offline' --cancel-label='Cancel' || return 1
  printf 'offline\n' > "$offline_flag"
  return 0
}

if ! /usr/bin/nm-online --quiet --timeout=45; then
  if offer_offline; then
    exec /usr/bin/sudo /usr/local/bin/hornero-installer-run
  fi
  /usr/bin/zenity --warning --title='HorneroOS installer' \
    --text='Connect to the internet before installing. No disk changes have been made.' || true
  exit 0
fi

if ! /usr/bin/timeout 10 /usr/bin/getent ahostsv4 archive.archlinux.org >/dev/null; then
  if offer_offline; then
    exec /usr/bin/sudo /usr/local/bin/hornero-installer-run
  fi
  /usr/bin/zenity --warning --title='HorneroOS installer' \
    --text='The network is connected, but the Arch package server cannot be resolved. Check your DNS or reconnect to the network, then start the installer again. No disk changes have been made.' || true
  exit 0
fi

exec /usr/bin/sudo /usr/local/bin/hornero-installer-run
