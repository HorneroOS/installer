#!/usr/bin/bash
set -u

# Offline consent comes from the live launcher as a flag file; it is
# never trusted on its own. Re-verify the on-media repository as root
# and only then create the root-owned 0600 marker and system selection
# the Calamares jobs consume, all before Calamares (pre-partition).
offline_flag=/tmp/hornero-installer-offline-accepted
if [[ -f "$offline_flag" ]] && grep -qx offline "$offline_flag"; then
  if /usr/bin/python3 /usr/lib/hornero-installer/offline-repo.py --verify-only; then
    /usr/bin/install -d -m 0755 /run/hornero-installer
    printf 'offline\n' | /usr/bin/install -m 0600 /dev/stdin /run/hornero-installer/offline-mode
    printf '{"offline": true}\n' | /usr/bin/install -m 0600 /dev/stdin /run/hornero-installer/system-selection.json
  else
    /usr/bin/logger -t hornero-installer "Offline mode requested but the on-media repository is incomplete; refusing to start."
    rm -f "$offline_flag"
    exit 1
  fi
  rm -f "$offline_flag"
fi

# Calamares runs as root and writes its session log below root's home. Keep a
# readable local copy for the live user after the window closes. This wrapper
# accepts no arguments; the live user's sudo rule permits only this fixed job.
/usr/bin/calamares -D6
installer_status=$?

# Calamares emergency modules do not run when a user cancels the wizard.
# Clean only temporary targets carrying this installer's repository includes.
cleanup_log=/var/log/hornero-installer/post-exit-cleanup.log
if ! /usr/bin/python3 /usr/local/lib/hornero-installer/cleanup-calamares-targets.py >"$cleanup_log" 2>&1; then
  /usr/bin/chmod 0640 "$cleanup_log" || true
  /usr/bin/chown root:hornero-live "$cleanup_log" || true
  /usr/bin/logger -t hornero-installer "Post-exit cleanup failed; see $cleanup_log"
else
  /usr/bin/chmod 0640 "$cleanup_log" || true
  /usr/bin/chown root:hornero-live "$cleanup_log" || true
fi

log_source=/root/.cache/calamares/session.log
log_destination=/var/log/hornero-installer/session.log
if [[ -r "$log_source" ]]; then
  /usr/bin/install -d -m 0750 -o root -g hornero-live /var/log/hornero-installer || true
  /usr/bin/install -D -m 0640 -o root -g hornero-live "$log_source" "$log_destination" || true
fi

exit "$installer_status"
